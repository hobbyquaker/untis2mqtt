{
  "name": "untis2mqtt",
  "version": "0.1.0",
  "description": "Interface between WebUntis school timetables and MQTT",
  "type": "module",
  "main": "index.js",
  "preferGlobal": true,
  "bin": {
    "untis2mqtt": "index.js"
  },
  "files": [
    "index.js",
    "config.js",
    "lib/",
    "example-accounts.json",
    "accounts.schema.json",
    "README.en.md"
  ],
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  },
  "scripts": {
    "start": "node index.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "deploy": "bash deploy.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hobbyquaker/untis2mqtt.git"
  },
  "keywords": [
    "mqtt",
    "smarthome",
    "mqtt-smarthome",
    "mqtt-interfaces",
    "home-automation",
    "home-assistant",
    "untis",
    "webuntis",
    "school",
    "timetable",
    "stundenplan"
  ],
  "author": "Sebastian Raff <hobbyquaker@gmail.com> (https://hobbyquaker.github.io)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hobbyquaker/untis2mqtt/issues"
  },
  "homepage": "https://github.com/hobbyquaker/untis2mqtt",
  "mqttInterfaces": {
    "spec": "2.0",
    "envPrefix": "UNTIS2MQTT",
    "needs": [
      "cloud"
    ],
    "serviceExtra": []
  },
  "dependencies": {
    "mqtt-interfaces-core": "^0.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0"
  }
}
