{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "untis2mqtt accounts",
  "description": "WebUntis logins of one untis2mqtt instance, e.g. one parent account per child",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["username"],
    "properties": {
      "username": {
        "type": "string",
        "minLength": 1,
        "description": "WebUntis user name"
      },
      "password": {
        "type": "string",
        "description": "password of the user",
        "x-secret": true
      },
      "secret": {
        "type": "string",
        "description": "app secret from the WebUntis data access QR code (schools with SSO login), instead of the password",
        "x-secret": true
      }
    },
    "anyOf": [
      {
        "required": ["password"]
      },
      {
        "required": ["secret"]
      }
    ]
  }
}
